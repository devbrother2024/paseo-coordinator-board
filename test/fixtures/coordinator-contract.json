{
  "version": 1,
  "tools": {
    "answer_board_fact": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cycleId": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "evidenceId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "cycleId",
        "evidenceId",
        "sessionId"
      ],
      "type": "object"
    },
    "assign_board_worker": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "job": {
          "additionalProperties": false,
          "properties": {
            "expectedHostId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "expectedModeId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "expectedRoute": {
              "properties": {
                "effort": {
                  "anyOf": [
                    {
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "provider": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "effort",
                "model",
                "provider"
              ],
              "type": "object"
            },
            "grade": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ],
              "type": "string"
            },
            "host": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "needsHooks": {
              "type": "boolean"
            },
            "platform": {
              "enum": [
                "any",
                "mac",
                "windows",
                "linux"
              ],
              "type": "string"
            },
            "projectId": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "prompt": {
              "maxLength": 24000,
              "minLength": 1,
              "type": "string"
            },
            "requestKey": {
              "maxLength": 96,
              "minLength": 12,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "type": "string"
            },
            "routeSource": {
              "const": "coordinator",
              "type": "string"
            },
            "title": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "workspaceId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "expectedRoute",
            "grade",
            "projectId",
            "prompt",
            "requestKey",
            "title",
            "workspaceId"
          ],
          "type": "object"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "board_action": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "input": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "classify_board_conversation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "content": {
          "properties": {
            "needsInput": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            "options": {
              "items": {
                "properties": {
                  "label": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string"
                  },
                  "reply": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "reply"
                ],
                "type": "object"
              },
              "maxItems": 10,
              "type": "array"
            },
            "question": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "recommendation": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "recommendationReason": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "evidenceId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "question",
            "review",
            "idle"
          ],
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "kind",
        "sessionId",
        "text"
      ],
      "type": "object"
    },
    "judge_board_pull": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "headSha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "type": "integer"
        },
        "ownerSessionId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "repo": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9_.-]{1,100}$",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "ready",
            "needs-changes",
            "in-progress",
            "blocked"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "plan_board_assignment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "needsHooks": {
          "type": "boolean"
        },
        "platform": {
          "enum": [
            "any",
            "mac",
            "windows",
            "linux"
          ],
          "type": "string"
        },
        "projectId": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "read_board_conversation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "read_board_guide": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "review_board_records": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "review": {
          "additionalProperties": false,
          "properties": {
            "evidenceId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "fingerprint": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "key": {
              "maxLength": 6000,
              "minLength": 1,
              "type": "string"
            },
            "quote": {
              "maxLength": 1600,
              "minLength": 8,
              "type": "string"
            }
          },
          "required": [
            "evidenceId",
            "fingerprint",
            "key",
            "quote"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  }
}
